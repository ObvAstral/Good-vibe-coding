{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "shared/src",
    "server",
    "scripts",
    "tests",
    "web/src",
    "web/vite.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "contracts/artifacts", "contracts/cache"]
}
