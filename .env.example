# Copiare in .env per avvio manuale locale. Nessuna chiave privata nel frontend.
RPC_URL=http://127.0.0.1:8545
MANIFEST_PATH=deployments/local.json
LOCAL_DEMO=1
# PUBLIC_RPC_URL=http://127.0.0.1:8545
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=.data/local.sqlite

# Facoltativo: LOCAL_DEMO=0 per usare operatori locali personalizzati.
# MACHINE_1_PRIVATE_KEY=0x...
# MACHINE_2_PRIVATE_KEY=0x...
# STORE_1_PRIVATE_KEY=0x...
# STORE_2_PRIVATE_KEY=0x...
# Il backend accetta soltanto RPC loopback e chainId Hardhat 31337.
