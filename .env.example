# Copiare in .env per avvio manuale locale. Nessuna chiave privata nel frontend.
RPC_URL=http://127.0.0.1:8545
MANIFEST_PATH=deployments/local.json
LOCAL_DEMO=1
# PUBLIC_RPC_URL=http://127.0.0.1:8545
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=.data/local.sqlite

# Facoltativo: LOCAL_DEMO=0 per usare operatori locali personalizzati.
# MACHINE_1_PRIVATE_KEY=0x...
# MACHINE_2_PRIVATE_KEY=0x...
# STORE_1_PRIVATE_KEY=0x...
# STORE_2_PRIVATE_KEY=0x...
# STORE_3_PRIVATE_KEY=0x...
# STORE_4_PRIVATE_KEY=0x...
# STORE_5_PRIVATE_KEY=0x...
# STORE_6_PRIVATE_KEY=0x...
# Il backend accetta soltanto RPC loopback e chainId Hardhat 31337.

# Planner: configurazione distinta dall'esempio CLI QVAC.
# Percorsi relativi alla radice del progetto. La probe non chiama DeepSeek.
QVAC_CONFIG_PATH=planner/qvac.config.js
QVAC_EMBEDDING_MODEL_PATH=.qvac/models/Qwen3-Embedding-0.6B-Q8_0.gguf
PLANNER_DB_PATH=data/processed/planner.sqlite
PLANNER_PORT=3002
PLANNER_SOURCE=history
PLANNER_HISTORY_PATH=data/simulated/history-v1
HARDHAT_RPC_URL=http://127.0.0.1:8545
DEPLOYMENT_MANIFEST_PATH=deployments/local.json
# Impostare solo sul server per abilitare la generazione; mai nel frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_BUDGET_USD=0.60
# Prezzi USD per milione di token: override richiesto per modelli non riconosciuti.
# DEEPSEEK_INPUT_PRICE=0.30
# DEEPSEEK_OUTPUT_PRICE=1.20
